# Copy to .env (same folder) and fill in your key. .env is gitignored — never commit it.

# Xiaomi MiMo API key. The launcher picks the endpoint from the prefix:
#   tp- / ttp-  -> Token Plan     https://token-plan-sgp.xiaomimimo.com/anthropic  (-Plan TokenPlanCn / TokenPlanAms for other regions)
#   sk-         -> Pay-as-you-go  https://api.xiaomimimo.com/anthropic
# MIMO_API_KEY is accepted as an alternative name.
MIMO_TOKEN_PLAN_API_KEY=tp-your_token_plan_key_here
